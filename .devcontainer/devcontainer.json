{
  "name": "Portfolio guided demo",
  "build": {"dockerfile": "Dockerfile"},
  "features": {"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}},
  "forwardPorts": [18780],
  "portsAttributes": {
    "18780": {"label": "Relay guided demo", "onAutoForward": "notify", "protocol": "http"},
    "15438": {"onAutoForward": "ignore"}
  },
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "postCreateCommand": "python scripts/setup_codespaces.py",
  "waitFor": "postCreateCommand",
  "postStartCommand": "python scripts/setup_codespaces.py --start-only",
  "remoteUser": "vscode"
}
