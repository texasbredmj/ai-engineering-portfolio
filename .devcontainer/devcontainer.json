{
  "name": "AI systems employer demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/docker-in-docker:4": {}},
  "forwardPorts": [18780],
  "portsAttributes": {"18780": {"label": "Employer walkthrough and dashboard", "onAutoForward": "openBrowser"}},
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "postCreateCommand": "python -m pip install httpx==0.28.1 playwright==1.64.0",
  "postStartCommand": "python scripts/start_platform.py",
  "postAttachCommand": "code .platform/DEMO-ACCESS.md",
  "remoteUser": "vscode",
  "hostRequirements": {"cpus": 2, "memory": "8gb", "storage": "32gb"}
}
