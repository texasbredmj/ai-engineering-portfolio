{
  "name": "AI systems employer demo",
  "build": {"dockerfile": "Dockerfile"},
  "features": {"ghcr.io/devcontainers/features/docker-in-docker:4": {}},
  "forwardPorts": [18780],
  "portsAttributes": {"18780": {"label": "Employer walkthrough and dashboard", "onAutoForward": "openBrowser"}},
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "postCreateCommand": "python scripts/setup_codespace.py",
  "postStartCommand": ".venv/bin/python scripts/start_platform.py",
  "postAttachCommand": ".venv/bin/python scripts/open_demo_guide.py",
  "remoteUser": "vscode",
  "remoteEnv": {"PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"},
  "hostRequirements": {"cpus": 2, "memory": "8gb", "storage": "32gb"}
}
